<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net48</TargetFrameworks>
    <!-- Restore/build every framework for portable lockfiles; net48 tests require Windows. -->
    <IsTestProject Condition="'$(TargetFramework)' == 'net48' and !$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
    <IsTestingPlatformApplication Condition="'$(TargetFramework)' == 'net48' and !$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <!-- Run the same adversarial cases against each actual library target,
         including the net462 assembly selected by the net48 tests. -->
    <Compile Include="../GeoTimeZone.DataBuilder.Tests/OrientationTests.cs;../GeoTimeZone.DataBuilder.Tests/CoordinateCodecTests.cs;../GeoTimeZone.DataBuilder.Tests/GridMathTests.cs;../GeoTimeZone.DataBuilder.Tests/CompressedResourceTests.cs;../GeoTimeZone.DataBuilder.Tests/TestDoubles.cs" Link="Robustness/%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\GeoTimeZone\GeoTimeZone.csproj" />
  </ItemGroup>

</Project>
